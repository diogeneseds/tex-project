---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import VoxelHero from '../components/VoxelHero.astro';
import OffersSection from '../components/OffersSection.astro';
import CategoriesSection from '../components/CategoriesSection.astro';
import VideosSection from '../components/VideosSection.astro';
import CommunitySection from '../components/CommunitySection.astro';
import { getCollection } from 'astro:content';
import { readData } from '../lib/readData';
import { postUrl } from '../lib/blogRoutes';

const siteConfig = readData('siteConfig.json');
const homeConfig = readData('home.json') as any;

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Pega 9 posts para a listagem principal das Últimas Notícias
const latestPosts = posts.length >= 9
  ? (posts.slice(9).length >= 9 ? posts.slice(9, 18) : posts.slice(0, 9))
  : posts;

const sectionTitle = homeConfig?.sectionTitles?.latestPosts || 'Últimas Notícias';

function getRelativeTime(date: Date) {
  const now = new Date();
  const diffInSeconds = Math.floor((now.getTime() - date.getTime()) / 1000);
  if (diffInSeconds < 3600) {
    const mins = Math.floor(diffInSeconds / 60) || 1;
    return `Há ${mins} minuto${mins > 1 ? 's' : ''}`;
  }
  if (diffInSeconds < 86400) {
    const hours = Math.floor(diffInSeconds / 3600);
    return `Há ${hours} hora${hours > 1 ? 's' : ''}`;
  }
  const days = Math.floor(diffInSeconds / 86400);
  if (days < 30) {
    return `Há ${days} dia${days > 1 ? 's' : ''}`;
  }
  return date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
}
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>

  <section class="container-xl pt-4 pb-0">
    
    <!-- Hero Estilo Voxel (5 slides + 3 lista + 1 destaque) -->
    <VoxelHero posts={posts} />

    <!-- Seção Ofertas TecExtreme -->
    <OffersSection />

    <!-- Seção Continue por Aqui (Categorias do Blog) -->
    <CategoriesSection />

    <!-- Seção Vídeos (Vídeos TecExtreme) -->
    <VideosSection />

    <!-- CONTAINER PRINCIPAL: LISTAGEM DE POSTS (ESQUERDA) + SIDEBAR (DIREITA) -->
    <div class="flex flex-col lg:flex-row gap-8 my-6">

      <!-- LISTAGEM PRINCIPAL DE POSTS (ÚLTIMAS NOTÍCIAS) -->
      <div class="flex-1 min-w-0">
        
        <!-- CABEÇALHO COM ÍCONE DE RSS / FEED E TÍTULO -->
        <div class="flex items-center justify-between mb-6 pb-3 border-b border-slate-200">
          <div class="flex items-center gap-2.5">
            <div class="text-[#2222D3] flex items-center justify-center">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 11a9 9 0 0 1 9 9" />
                <path d="M4 4a16 16 0 0 1 16 16" />
                <circle cx="5" cy="19" r="1" fill="currentColor" />
              </svg>
            </div>
            <h2 class="h5 fw-extrabold m-0 text-dark" style="font-family: var(--font-heading); color: #0B0F19;">
              {sectionTitle}
            </h2>
          </div>
        </div>

        {posts.length === 0 && (
          <div class="bg-white rounded-xl border border-gray-200 p-8 text-center text-gray-500">
            <p>Nenhum artigo publicado ainda.</p>
          </div>
        )}

        <!-- LISTA HORIZONTAL DE CARDS DE POSTS (ESTILO TECMUNDO) -->
        <div class="flex flex-col divide-y divide-slate-100">
          {latestPosts.map(post => (
            <article class="relative py-4 first:pt-0 last:pb-0 group">
              <div class="flex flex-row gap-4 sm:gap-5 items-center min-h-[138px]">
                <!-- THUMBNAIL DO POST (ESQUERDA - 172x138px) -->
                <a href={postUrl(post.slug)} class="block relative w-[172px] h-[138px] flex-shrink-0 overflow-hidden rounded-2xl bg-slate-100">
                  {post.data.heroImage ? (
                    <img
                      src={post.data.heroImage}
                      alt={post.data.title}
                      loading="lazy"
                      width="400"
                      height="225"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                  ) : (
                    <div class="w-full h-full bg-slate-200 flex items-center justify-center text-slate-400 font-bold text-xs">
                      TecExtreme
                    </div>
                  )}
                </a>

                <!-- DETALHES DO POST (DIREITA) -->
                <div class="flex-1 min-w-0 flex flex-col justify-center">
                  <!-- CATEGORIA COM SQUARE DE COR -->
                  {post.data.category && (
                    <div class="flex items-center gap-1.5 mb-1.5">
                      <span class="text-[11px] font-extrabold uppercase tracking-wider text-[#2222D3]">
                        {post.data.category}
                      </span>
                      <span class="w-1.5 h-1.5 rounded-xs bg-[#2222D3] inline-block"></span>
                    </div>
                  )}

                  <!-- TÍTULO DO POST COM COR ESCURA EXPLÍCITA #0B0F19 -->
                  <h3 class="m-0 leading-snug" style="font-family: var(--font-heading);">
                    <a
                      href={postUrl(post.slug)}
                      class="post-title-link font-extrabold text-decoration-none d-block line-clamp-2"
                      style="font-size: 1.05rem; color: #0B0F19; line-height: 1.35; transition: color 0.2s ease;"
                    >
                      {post.data.title}
                    </a>
                  </h3>

                  <!-- TEMPO RELATIVO -->
                  <span class="text-xs text-slate-400 mt-2 block">
                    {getRelativeTime(post.data.pubDate)}
                  </span>
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- BOTÃO "MAIS NOTÍCIAS RECENTES" (LEVA PARA /BLOG) -->
        <div class="mt-8">
          <a
            href="/blog"
            class="block w-full text-center py-3.5 px-6 rounded-xl font-extrabold text-white bg-[#2222D3] hover:bg-blue-700 shadow-md hover:shadow-lg transition-all text-sm tracking-wide"
            style="font-family: var(--font-heading);"
          >
            Mais notícias recentes
          </a>
        </div>
      </div>

      <!-- SIDEBAR COMPLETA COM LARGURA EXATA DE 380PX (DIREITA) -->
      <aside class="w-full lg:w-[380px] flex-shrink-0">
        <Sidebar />
      </aside>

    </div>

    <!-- SEÇÃO COMUNIDADE: NEWSLETTER MAILCHIMP + CANAL DO WHATSAPP -->
    <CommunitySection />
  </section>

</BaseLayout>

<style>
  .post-title-link:hover {
    color: var(--walker-accent, #2222D3) !important;
  }
</style>
