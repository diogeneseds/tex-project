---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import VoxelHero from '../components/VoxelHero.astro';
import OffersSection from '../components/OffersSection.astro';
import CategoriesSection from '../components/CategoriesSection.astro';
import { getCollection } from 'astro:content';
import { readData } from '../lib/readData';
import { postUrl } from '../lib/blogRoutes';

const siteConfig = readData('siteConfig.json');
const homeConfig = readData('home.json') as any;

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Voxel Hero usa 9 posts (5 slider + 3 lista + 1 card destaque)
const remainingPosts = posts.slice(9);
const latestLimit = homeConfig?.latestPosts?.limit ?? 6;
const latestPosts = remainingPosts.slice(0, latestLimit);
const latestBtnText = homeConfig?.latestPosts?.btnText || 'Ver Todos os Posts';
const latestBtnLink = homeConfig?.latestPosts?.btnLink || '/blog';
const sectionTitle = homeConfig?.sectionTitles?.latestPosts || 'Últimas Atualizações';

function formatDate(date: Date) {
  return date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
}
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>

  <section class="container-xl py-4">
    
    <!-- Hero Estilo Voxel (5 slides + 3 lista + 1 destaque) -->
    <VoxelHero posts={posts} />

    <!-- Seção Ofertas TecExtreme -->
    <OffersSection />

    <!-- Seção Continue por Aqui (Categorias do Blog) -->
    <CategoriesSection />

    <div class="flex flex-col lg:flex-row gap-8">

      <!-- Main content list -->
      <div class="flex-1 min-w-0">
        <div class="flex items-center justify-between mb-6 pb-2 border-b border-slate-200 dark:border-slate-800">
          <h2 class="text-xl font-bold text-slate-900" style="font-family: var(--font-heading);">{sectionTitle}</h2>
          <a href="/blog" class="text-xs font-semibold text-[#2222D3] hover:underline">Ver Todos</a>
        </div>

        {posts.length === 0 && (
          <div class="bg-white rounded-xl border border-gray-200 p-8 text-center text-gray-500">
            <p>Nenhum artigo publicado ainda.</p>
          </div>
        )}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {latestPosts.map(post => (
            <article class="bg-white rounded-xl border border-slate-200 overflow-hidden flex flex-col hover:shadow-lg transition-all duration-300 group">
              <a href={postUrl(post.slug)} class="block relative aspect-[16/9] overflow-hidden bg-slate-100">
                {post.data.heroImage ? (
                  <img
                    src={post.data.heroImage}
                    alt={post.data.title}
                    loading="lazy"
                    width="400"
                    height="225"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                ) : (
                  <div class="w-full h-full bg-slate-100 flex items-center justify-center text-slate-400">TecExtreme</div>
                )}
                {post.data.category && (
                  <span class="absolute top-3 left-3 bg-slate-900/80 backdrop-blur-md text-[#70EDED] text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md">
                    {post.data.category}
                  </span>
                )}
              </a>
              <div class="p-5 flex flex-col justify-between flex-1 gap-2">
                <div>
                  <h3 class="text-base font-bold text-slate-900 leading-snug group-hover:text-[#2222D3] transition-colors" style="font-family: var(--font-heading);">
                    <a href={postUrl(post.slug)}>{post.data.title}</a>
                  </h3>
                  {post.data.description && (
                    <p class="text-xs text-slate-500 line-clamp-2 mt-2 leading-relaxed">{post.data.description}</p>
                  )}
                </div>
                <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
                  <time>{formatDate(post.data.pubDate)}</time>
                  <a href={postUrl(post.slug)} class="text-[#2222D3] font-semibold hover:underline">Ler &rarr;</a>
                </div>
              </div>
            </article>
          ))}
        </div>

        {remainingPosts.length > latestLimit && (
          <div class="text-center mt-10">
            <a href={latestBtnLink} class="inline-block px-6 py-3 rounded-lg text-sm font-bold text-white bg-[#2222D3] hover:bg-blue-700 shadow-md hover:shadow-lg transition-all">
              {latestBtnText}
            </a>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="lg:w-80 flex-shrink-0">
        <Sidebar />
      </aside>

    </div>
  </section>

</BaseLayout>
