---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import CategoriesSection from '../components/CategoriesSection.astro';
import EmailInlineBanner from '../plugins/email-list/EmailInlineBanner.astro';
import AffiliateProducts from '../plugins/affiliates/AffiliateProducts.astro';
import PostSchemaPlugins from '../plugins/_slots/PostSchemaPlugins.astro';
import PostBottomPlugins from '../plugins/_slots/PostBottomPlugins.astro';
import PostAfterPlugins from '../plugins/_slots/PostAfterPlugins.astro';
import SocialShare from '../plugins/social-share/SocialShare.astro';
import { getCollection } from 'astro:content';
import { readData } from '../lib/readData';
import { postUrl, getImageSrc } from '../lib/blogRoutes';

const authorsData = readData('authors.json', []);
const pluginsConfig = readData('pluginsConfig.json', {}) as any;
const inlineConfig = pluginsConfig?.emailList?.inline;
const inlineEnabled = inlineConfig?.enabled === true;
const inlinePosition = Number(inlineConfig?.position ?? 3);

export async function getStaticPaths() {
  const RESERVED = ['contato', 'sobre', 'privacidade', 'termos', 'blog', 'admin', 'api', 'categoria', 'tag'];
  const siteConfig = (await import('../lib/readData')).readData('siteConfig.json');
  const prefix = siteConfig.blogPrefix ?? '';

  if (prefix !== '') return [];

  const posts = await getCollection('blog');
  return posts
    .filter(post => !RESERVED.includes(post.slug))
    .map((post) => ({
      params: { slug: post.slug },
      props: post,
    }));
}

const post = Astro.props;
const { Content } = await post.render();

const currentAuthor = authorsData.find((a: any) => a.id === post.data.author) || authorsData[0] || {
  name: 'Equipe TecExtreme',
  role: 'Redação',
  avatar: '',
  bio: 'Acompanhando as principais inovações tecnológicas, lançamentos e análises do mundo digital.'
};

const categorySlug = post.data.category ? post.data.category.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, '-') : '';
const siteConfig = readData('siteConfig.json', {}) as any;
const fullPostUrl = `${siteConfig.url || Astro.url.origin}${postUrl(post.slug)}`;

// Tempo de leitura estimado
const wordCount = post.body ? post.body.split(/\s+/).length : 200;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

function getRelativeTime(date: Date) {
  const now = new Date();
  const diffInSeconds = Math.floor((now.getTime() - date.getTime()) / 1000);
  if (diffInSeconds < 3600) {
    const mins = Math.floor(diffInSeconds / 60) || 1;
    return `Há ${mins} minuto${mins > 1 ? 's' : ''}`;
  }
  if (diffInSeconds < 86400) {
    const hours = Math.floor(diffInSeconds / 3600);
    return `Há ${hours} hora${hours > 1 ? 's' : ''}`;
  }
  const days = Math.floor(diffInSeconds / 86400);
  if (days < 30) {
    return `Há ${days} dia${days > 1 ? 's' : ''}`;
  }
  return date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
}
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.heroImage} type="article">
  <PostSchemaPlugins
    title={post.data.title}
    description={post.data.description || ''}
    url={fullPostUrl}
    image={post.data.heroImage}
    datePublished={post.data.pubDate instanceof Date ? post.data.pubDate.toISOString() : post.data.pubDate}
    authorName={currentAuthor?.name}
    category={post.data.category}
  />

  <section class="container-xl py-6">
    
    <!-- HEADER DO POST - LARGURA TOTAL DA PÁGINA (ESTILO TECMUNDO) -->
    <header class="mb-6">
      
      <!-- BREADCRUMB -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-4 font-semibold uppercase tracking-wider w-full overflow-hidden">
        <a href="/" class="hover:text-[#2222D3] transition-colors text-decoration-none flex-shrink-0">Home</a>
        {post.data.category && (
          <>
            <span class="text-slate-300 flex-shrink-0">/</span>
            <a href={`/categoria/${categorySlug}`} class="hover:text-[#2222D3] transition-colors text-decoration-none flex-shrink-0">{post.data.category}</a>
          </>
        )}
        <span class="text-slate-300 flex-shrink-0">/</span>
        <span class="text-slate-400 truncate flex-1 min-w-0">{post.data.title}</span>
      </nav>

      <!-- SELO DA CATEGORIA COM QUADRADO AZUL -->
      {post.data.category && (
        <div class="flex items-center gap-1.5 mb-2.5">
          <span class="text-xs font-extrabold uppercase tracking-wider text-[#2222D3]">
            {post.data.category}
          </span>
          <span class="w-2 h-2 rounded-xs bg-[#2222D3] inline-block"></span>
        </div>
      )}

      <!-- TÍTULO PRINCIPAL (H1 - LARGURA TOTAL DO CONTAINER) -->
      <h1 class="text-3xl sm:text-4xl lg:text-[2.6rem] font-extrabold text-[#0B0F19] leading-[1.2] mb-3 max-w-5xl" style="font-family: var(--font-heading);">
        {post.data.title}
      </h1>

      <!-- SUBTÍTULO / DESCRIÇÃO (LINHA DE FATO - LARGURA TOTAL DO CONTAINER) -->
      {post.data.description && (
        <p class="text-lg sm:text-xl text-slate-500 font-medium leading-relaxed mb-6 max-w-4xl">
          {post.data.description}
        </p>
      )}

      <!-- BARRA COMPLETA DE AUTORIA & COMPARTILHAMENTO (ESTILO TECMUNDO) -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-1 pb-4 text-xs mb-6">
        <div class="flex items-center gap-3">
          {currentAuthor.avatar ? (
            <img src={currentAuthor.avatar} alt={currentAuthor.name} class="w-10 h-10 rounded-full object-cover shadow-sm" />
          ) : (
            <div class="w-10 h-10 rounded-full bg-[#0B0F19] text-white flex items-center justify-center font-extrabold text-sm shadow-sm">
              {currentAuthor.name.charAt(0)}
            </div>
          )}
          <div>
            <!-- NOME DO AUTOR (TEXTO ESCURO #0B0F19) -->
            <div class="font-extrabold text-[#0B0F19] text-sm leading-snug">
              {currentAuthor.name}
            </div>

            <!-- METADADOS DE DATA E TEMPO DE LEITURA (TEXTO VISÍVEL SLATE-600 #475569) -->
            <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1 text-[#475569] font-medium text-[12px] mt-0.5">
              
              <!-- DATA DE PUBLICAÇÃO COM ÍCONE DE RELÓGIO -->
              <span class="flex items-center gap-1.5" title="Data de publicação">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-500">
                  <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
                <span>
                  {post.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' })}
                  {post.data.pubDate.getHours() !== 0 || post.data.pubDate.getMinutes() !== 0 ? `, às ${post.data.pubDate.getHours().toString().padStart(2, '0')}:${post.data.pubDate.getMinutes().toString().padStart(2, '0')}` : ''}
                </span>
              </span>

              <!-- DATA DE ATUALIZAÇÃO (SE HOUVER) -->
              {(post.data as any).updatedDate && (
                <span class="flex items-center gap-1.5" title="Data de atualização">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-500">
                    <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                    <path d="M3 3v5h5"/>
                    <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
                    <path d="M16 16h5v5"/>
                  </svg>
                  <span>
                    Atualizado em {new Date((post.data as any).updatedDate).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' })}
                  </span>
                </span>
              )}

              <!-- TEMPO DE LEITURA -->
              <span class="flex items-center gap-1.5" title="Tempo de leitura estimado">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-500">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                </svg>
                <span>{readingTime} min de leitura</span>
              </span>

            </div>
          </div>
        </div>

        <!-- BOTÕES DE COMPARTILHAMENTO SOCIAL (ALINHADOS À DIREITA) -->
        <SocialShare title={post.data.title} context="header" />
      </div>

      <!-- IMAGEM EM DESTAQUE DO POST EM LARGURA TOTAL DA PÁGINA (HERO IMAGE - 1000x400 FORMATO TECMUNDO) -->
      {post.data.heroImage && (
        <div class="w-full h-[320px] sm:h-[400px] lg:h-[420px] rounded-2xl overflow-hidden shadow-sm bg-slate-100 mb-2">
          <img
            src={getImageSrc(post.data.heroImage)}
            alt={post.data.title}
            class="w-full h-full object-cover"
          />
        </div>
      )}

    </header>

    <!-- DOBRA PRINCIPAL: CORPO DO POST DA ESQUERDA + SIDEBAR DIREITA (380PX) -->
    <div class="flex flex-col lg:flex-row gap-8">
      
      <!-- COLUNA PRINCIPAL DO ARTIGO (ESQUERDA) -->
      <article class="flex-1 min-w-0">
        
        <!-- CORPO DO ARTIGO (.post-content COM ESTILIZAÇÃO TECMUNDO) -->
        <div class="post-content">
          <Content />
        </div>

        <!-- BANNER DE EMAIL INLINE -->
        {inlineEnabled && (
          <div id="email-inline-source" data-position={inlinePosition} style="display:none">
            <EmailInlineBanner />
          </div>
        )}

        <!-- PRODUTOS AFILIADOS -->
        <AffiliateProducts />

        <!-- TAGS RELACIONADAS DO POST (ESTILO TECMUNDO - COM BORDAS DIVISÓRIAS SUPERIOR E INFERIOR) -->
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="py-4 border-y border-slate-200 my-6">
            <div class="flex flex-wrap gap-2.5">
              {post.data.tags.map((t: string) => {
                const tagSlug = t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, '-');
                return (
                  <a
                    href={`/tag/${tagSlug}`}
                    class="px-3.5 py-1.5 rounded-lg bg-slate-100 hover:bg-[#2222D3] text-[#2222D3] hover:text-white font-extrabold text-xs transition-colors text-decoration-none inline-flex items-center gap-1"
                  >
                    <span>#</span> {t}
                  </a>
                );
              })}
            </div>
          </div>
        )}

        <!-- BARRA DE COMPARTILHAMENTO SOCIAL (DEPOIS DAS TAGS, ANTES DO AUTOR) -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-slate-200 mb-6">
          <span class="text-xs font-extrabold uppercase tracking-wider text-slate-400">Gostou? Compartilhe:</span>
          <PostBottomPlugins title={post.data.title} />
        </div>

        <!-- BOX DO AUTOR (ESTILO TECMUNDO - SEM BORDAS DE CARD, APENAS LINHAS DE SEPARAÇÃO) -->
        <div class="pb-6 border-b border-slate-200 mb-8">
          <div class="flex items-start gap-4">
            {currentAuthor.avatar ? (
              <img src={currentAuthor.avatar} alt={currentAuthor.name} class="w-12 h-12 rounded-full object-cover shadow-xs flex-shrink-0 mt-0.5" />
            ) : (
              <div class="w-12 h-12 rounded-full bg-[#0B0F19] text-white flex items-center justify-center font-extrabold text-base shadow-xs flex-shrink-0 mt-0.5">
                {currentAuthor.name.charAt(0)}
              </div>
            )}
            <div class="flex-1 min-w-0">
              <h4 class="font-extrabold text-base text-[#0B0F19] mb-1 leading-snug" style="font-family: var(--font-heading);">
                {currentAuthor.name}
              </h4>
              {currentAuthor.bio ? (
                <p class="text-sm text-slate-600 leading-relaxed mb-3">
                  {currentAuthor.bio}
                </p>
              ) : currentAuthor.role ? (
                <p class="text-sm text-slate-600 leading-relaxed mb-3">
                  {currentAuthor.role} na equipe de redação do TecExtreme.
                </p>
              ) : null}
              <div class="flex items-center gap-3 text-[#2222D3]">
                <a href="#" aria-label="LinkedIn" class="hover:opacity-80 transition-opacity text-base"><i class="fab fa-linkedin"></i></a>
                <a href="#" aria-label="Instagram" class="hover:opacity-80 transition-opacity text-base"><i class="fab fa-instagram"></i></a>
              </div>
            </div>
          </div>
        </div>

        <!-- SEÇÃO DE COMENTÁRIOS (ESTILO TECMUNDO: "E você, o que tem a dizer?") -->
        <div class="pt-2 mb-10">
          
          <!-- TÍTULO PRINCIPAL COM ÍCONE DE BALÃO DE DIÁLOGO TECMUNDO -->
          <div class="flex items-center gap-2.5 text-xl font-black text-[#0B0F19] mb-5" style="font-family: var(--font-heading);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2222D3" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            <span>E você, o que tem a dizer?</span>
          </div>

          <!-- ABA ATIVA DE COMENTÁRIOS -->
          <div class="border-b border-slate-200 mb-6 flex items-center">
            <div class="inline-flex items-center gap-2 px-4 py-2.5 border-t-2 border-x border-t-[#2222D3] border-x-slate-200 bg-white rounded-t-md text-[#2222D3] font-extrabold text-sm relative -mb-px">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
              <span>Comentários</span>
            </div>
          </div>

          <!-- PARTICIPE DA CONVERSA COM BOTÕES CADASTRE-SE E ENTRAR -->
          <div class="flex items-center justify-between gap-3 mb-3">
            <h5 class="text-sm font-extrabold text-[#0B0F19] m-0">Participe da conversa</h5>
            <div class="flex items-center gap-2">
              <a href="#" class="px-3 py-1 rounded bg-[#2222D3] text-white font-extrabold text-[11px] uppercase tracking-wider hover:bg-[#1a1aa6] transition-colors text-decoration-none">
                CADASTRE-SE
              </a>
              <a href="#" class="px-3 py-1 rounded border border-[#2222D3] text-[#2222D3] font-extrabold text-[11px] uppercase tracking-wider hover:bg-indigo-50 transition-colors text-decoration-none">
                ENTRAR
              </a>
            </div>
          </div>

          <!-- FORMULÁRIO DE COMENTÁRIO E BOTAO CTA TECMUNDO -->
          <form id="comment-form" method="post" class="flex flex-col gap-3 mb-8">
            <textarea
              name="InputComment"
              rows="3"
              placeholder="Participe da conversa"
              required
              class="w-full border border-slate-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#2222D3] bg-white transition-all resize-y placeholder:text-slate-400"
            ></textarea>
            
            <button
              type="submit"
              class="w-full py-3 rounded-lg bg-[#2222D3] hover:bg-[#1a1aa6] text-white font-extrabold text-sm transition-colors border-0 cursor-pointer shadow-xs"
            >
              Entre e Participe da Conversa
            </button>
          </form>

          <!-- LISTA DE COMENTÁRIOS DO POST -->
          <div class="mt-8 pt-2">
            <!-- HEADER DA LISTA DE COMENTÁRIOS COM DESTAQUE AZUL -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-slate-200 mb-5">
              <div class="inline-flex items-center gap-1.5 pb-2 -mb-2 border-b-2 border-[#2222D3] font-extrabold text-sm text-[#0B0F19]">
                <span>Todos os comentários</span>
                <span class="bg-[#2222D3] text-white text-xs px-2 py-0.5 rounded font-extrabold">1</span>
              </div>
              <div class="flex items-center gap-2">
                <select class="border border-slate-300 rounded-md px-3 py-1.5 text-xs font-semibold text-slate-700 bg-white focus:outline-none focus:ring-1 focus:ring-[#2222D3] cursor-pointer">
                  <option>Mais novos</option>
                  <option>Mais antigos</option>
                  <option>Mais votados</option>
                </select>
              </div>
            </div>

            <!-- COMENTÁRIO EXEMPLO (IGUAL AO TECMUNDO) -->
            <div class="space-y-4">
              <div class="text-sm text-slate-700 py-3 border-b border-slate-100">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-slate-400 text-xs">—</span>
                  <strong class="font-extrabold text-[#0B0F19] text-sm">Supermidiamkt</strong>
                  <span class="text-xs text-slate-400 font-normal">há 3 horas</span>
                </div>
                <p class="text-slate-600 text-sm leading-relaxed m-0 pl-3">
                  Excelente matéria! Acompanho de perto as inovações na indústria de games e na renderização em tempo real. As evoluções trazidas pelos novos motores gráficos e ray tracing estão realmente redefinindo a experiência nos jogos de última geração.
                </p>
              </div>
            </div>
          </div>

        </div>

        <!-- POSTS RELACIONADOS DA MESMA CATEGORIA -->
        <div class="mt-10">
          <PostAfterPlugins
            currentSlug={post.slug}
            category={post.data.category || ''}
          />
        </div>

      </article>

      <!-- SIDEBAR DIREITA (380PX) -->
      <aside class="w-full lg:w-[380px] flex-shrink-0">
        <Sidebar />
      </aside>

    </div>

    <!-- SEÇÃO CONTINUE POR AQUI (CATEGORIAS) -->
    <div class="mt-10">
      <CategoriesSection />
    </div>

  </section>

  <!-- SCRIPTS E ESTILOS DA PÁGINA DO POST -->
  <style is:global>
    .post-content {
      font-size: 1.0625rem;
      line-height: 1.8;
      color: #1e293b;
    }
    .post-content p {
      margin-bottom: 1.5rem;
    }
    .post-content h1,
    .post-content h2 {
      font-family: var(--font-heading);
      font-size: 1.65rem;
      font-weight: 800;
      color: #0b0f19;
      margin-top: 2.25rem;
      margin-bottom: 1rem;
      padding-left: 0.85rem;
      border-left: 4px solid #2222d3;
      line-height: 1.3;
    }
    .post-content h3 {
      font-family: var(--font-heading);
      font-size: 1.35rem;
      font-weight: 700;
      color: #0b0f19;
      margin-top: 1.75rem;
      margin-bottom: 0.75rem;
      line-height: 1.35;
    }
    .post-content h4 {
      font-family: var(--font-heading);
      font-size: 1.15rem;
      font-weight: 700;
      color: #0b0f19;
      margin-top: 1.5rem;
      margin-bottom: 0.5rem;
    }
    .post-content ul {
      list-style-type: disc;
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
    }
    .post-content ol {
      list-style-type: decimal;
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
    }
    .post-content li {
      margin-bottom: 0.5rem;
    }
    .post-content blockquote {
      border-left: 4px solid #70eded;
      background-color: #f8fafc;
      padding: 1.25rem 1.5rem;
      margin-bottom: 1.5rem;
      border-radius: 0 0.75rem 0.75rem 0;
      font-style: italic;
      color: #334155;
    }
    .post-content img {
      border-radius: 1rem;
      margin-top: 1.5rem;
      margin-bottom: 1.5rem;
      width: 100%;
      height: auto;
    }
    .post-content a {
      color: #2222d3;
      text-decoration: underline;
      font-weight: 600;
    }
    .post-content a:hover {
      color: #70eded;
    }
  </style>

  <script is:inline>
  (function() {
    var postContent = document.querySelector('.post-content');
    if (!postContent) return;
    var walker = document.createTreeWalker(postContent, NodeFilter.SHOW_TEXT, null);
    var node;
    while ((node = walker.nextNode())) {
      if (node.nodeValue && node.nodeValue.indexOf('\u00A0') !== -1) {
        node.nodeValue = node.nodeValue.replace(/\u00A0/g, ' ');
      }
    }
  })();
  </script>

  {inlineEnabled && (
    <script>
    (function() {
      const source = document.getElementById('email-inline-source');
      if (!source) return;
      const pos = Number((source as HTMLElement).dataset.position) || 3;
      const paragraphs = document.querySelectorAll('.post-content > p');
      const target = paragraphs[pos - 1] || paragraphs[paragraphs.length - 1];
      if (target) {
        target.insertAdjacentElement('afterend', source);
        source.style.display = 'block';
      }
    })();
    </script>
  )}

</BaseLayout>
