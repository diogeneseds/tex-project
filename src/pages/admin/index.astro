---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';
import { readData } from '../../lib/readData';

const posts = await getCollection('blog');
const totalPosts = posts.length;
const draftPosts = posts.filter(p => p.data && p.data.draft === true).length;
const publishedPosts = totalPosts - draftPosts;

const authors = readData('authors.json', []);
const totalAuthors = Array.isArray(authors) ? authors.length : 0;
---
<AdminLayout title="Dashboard" activeSection="dashboard">
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-slate-900">Dashboard</h1>
        <p class="text-slate-500 mt-1">Bem-vindo ao painel admin do seu blog.</p>
    </div>

    <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-3">Estatísticas</p>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
            <div class="bg-white rounded-xl border border-slate-100 p-5 flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-slate-400">Total de artigos</p>
                    <svg class="w-4 h-4 text-violet-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                </div>
                <p class="text-3xl font-bold text-slate-900 leading-none">{totalPosts}</p>
            </div>

            <div class="bg-white rounded-xl border border-slate-100 p-5 flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-slate-400">Publicados</p>
                    <svg class="w-4 h-4 text-violet-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <p class="text-3xl font-bold text-slate-900 leading-none">{publishedPosts}</p>
            </div>

            <div class="bg-white rounded-xl border border-slate-100 p-5 flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-slate-400">Rascunhos</p>
                    <svg class="w-4 h-4 text-violet-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                </div>
                <p class="text-3xl font-bold text-slate-900 leading-none">{draftPosts}</p>
            </div>

            <div class="bg-white rounded-xl border border-slate-100 p-5 flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-slate-400">Equipe</p>
                    <svg class="w-4 h-4 text-violet-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                </div>
                <p class="text-3xl font-bold text-slate-900 leading-none">{totalAuthors}</p>
            </div>
        </div>

        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <a href="/admin/posts/new" class="p-5 rounded-xl border transition-all hover:-translate-y-0.5 bg-violet-600 border-violet-500 text-white hover:bg-violet-700">
                <p class="font-bold text-sm text-white">Novo Artigo</p>
                <p class="text-xs mt-1 text-violet-200">Escrever e publicar um novo post</p>
            </a>
            <a href="/admin/posts" class="p-5 rounded-xl border transition-all hover:-translate-y-0.5 bg-white border-slate-200 text-slate-700 hover:border-violet-200 hover:shadow-sm">
                <p class="font-bold text-sm text-slate-800">Ver Artigos</p>
                <p class="text-xs mt-1 text-slate-500">Gerenciar todos os artigos</p>
            </a>
            <a href="/admin/config" class="p-5 rounded-xl border transition-all hover:-translate-y-0.5 bg-white border-slate-200 text-slate-700 hover:border-violet-200 hover:shadow-sm">
                <p class="font-bold text-sm text-slate-800">Configurações</p>
                <p class="text-xs mt-1 text-slate-500">Nome do site, cores e fontes</p>
            </a>
        </div>
    </div>
</AdminLayout>
