---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import AffiliateManager from '../../plugins/affiliates/AffiliateManager';
---
<AdminLayout title="Produtos & Afiliados" activeSection="affiliates">
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-slate-900">Produtos & Afiliados</h1>
        <p class="text-slate-500 mt-1">Gerencie produtos, ofertas e links de afiliados (Amazon, Mercado Livre, Shopee, etc.) para a home e artigos.</p>
    </div>
    <AffiliateManager client:load />
</AdminLayout>
