---
import { readData } from '../../lib/readData';

interface Props {
  slotId?: string;
}

const { slotId } = Astro.props;
const pluginsConfig = readData('pluginsConfig.json', {}) as any;
const adsenseConfig = pluginsConfig?.adsense || {};
const isAdsenseEnabled = adsenseConfig.enabled && adsenseConfig.publisherId;
---

<div class="widget-ad-container bg-slate-50 border border-slate-200 dark:bg-slate-900/60 dark:border-slate-800 rounded-4 p-3 text-center overflow-hidden">
  <div class="text-uppercase text-slate-400 font-bold mb-2 tracking-wider" style="font-size: 10px;">
    Publicidade
  </div>

  {isAdsenseEnabled ? (
    <div class="adsense-slot min-h-[250px] flex items-center justify-center">
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={adsenseConfig.publisherId}
        data-ad-slot={slotId || adsenseConfig.sidebarSlotId || '1234567890'}
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>
  ) : (
    <!-- FALLBACK DE BANNER DE PUBLICIDADE / PARCEIRO TECEXTREME -->
    <div
      class="ad-banner-placeholder rounded-3 p-4 d-flex flex-column align-items-center justify-content-center text-center position-relative overflow-hidden"
      style="min-height: 220px; background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); border: 1px dashed rgba(112, 237, 237, 0.3);"
    >
      <div class="mb-2 opacity-80">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#70EDED" stroke-width="1.8">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
          <line x1="8" y1="21" x2="16" y2="21" />
          <line x1="12" y1="17" x2="12" y2="21" />
        </svg>
      </div>
      <span class="text-white font-extrabold text-xs mb-1" style="font-family: var(--font-heading);">
        Espaço Publicitário
      </span>
      <span class="text-slate-400 text-xs mb-3" style="font-size: 11px;">
        Anuncie sua marca no TecExtreme
      </span>
      <a
        href="/contato"
        class="btn btn-sm rounded-pill font-bold px-3 py-1 text-xs text-white"
        style="background-color: var(--walker-accent, #2222D3); font-size: 11px;"
      >
        Anunciar Aqui
      </a>
    </div>
  )}
</div>
