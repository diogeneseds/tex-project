---
import WidgetAd from './WidgetAd.astro';
import WidgetPopularPosts from './WidgetPopularPosts.astro';
import WidgetShorts from './WidgetShorts.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<aside class="space-y-6 sticky top-24">
  <!-- 1. PUBLICIDADE -->
  <WidgetAd slotId="sidebar-top-ad" />

  <!-- 2. MAIS LIDAS (POSTS ALEATÓRIOS GERADOS AUTOMATICAMENTE) -->
  <WidgetPopularPosts posts={posts} title="Mais lidas" />

  <!-- 3. PUBLICIDADE NOVAMENTE -->
  <WidgetAd slotId="sidebar-middle-ad" />

  <!-- 4. SHORTS (COM FALLBACK TECEXTREME) -->
  <WidgetShorts />
</aside>
