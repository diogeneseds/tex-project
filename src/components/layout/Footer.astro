---
import { getCollection } from 'astro:content';
import { readData } from '../../lib/readData';
import { blogIndexUrl } from '../../lib/blogRoutes';

const siteConfig = readData('siteConfig.json');
const categoriesData = readData('categories.json', []);
const partnersData = readData('partners.json', []) as Array<{ name: string; url: string }>;

const posts = await getCollection('blog');
const categoriesFromPosts = [...new Set(posts.map(post => post.data.category).filter(Boolean))];
const finalCategoriesData = Array.isArray(categoriesData) ? categoriesData : [];
const allCategories = finalCategoriesData.length > 0 ? finalCategoriesData : categoriesFromPosts;

const currentYear = new Date().getFullYear();
const footerLogo = '/logo-tecextreme-header.svg';
---

<footer class="bg-[#0B0F19] text-white pt-12 pb-8 border-t border-slate-800/80 mt-0" style="margin-top: 0 !important;">
  <div class="container-xl max-w-7xl mx-auto px-4">
    
    <!-- PARTE SUPERIOR: LOGO CENTRALIZADA (MESMAS CORES DO HEADER) + DESCRIÇÃO INSTITUCIONAL -->
    <div class="text-center max-w-2xl mx-auto mb-8">
      <a href="/" class="d-inline-block mb-3">
        <img
          src={footerLogo}
          alt={siteConfig.name}
          class="h-10 sm:h-12 w-auto mx-auto object-contain"
        />
      </a>
      <p class="text-slate-400 text-xs sm:text-sm leading-relaxed m-0 px-2" style="font-family: var(--font-body, inherit);">
        No {siteConfig.name} você fica por dentro dos principais acontecimentos da tecnologia. Celulares, análises, hardware, inteligência artificial, tutoriais e mais, você descobre aqui!
      </p>
    </div>

    <!-- LINHA DIVISÓRIA -->
    <div class="w-full h-px bg-slate-800/80 mb-8"></div>

    <!-- NAVEGAÇÃO DE COLUNAS ESTILO TECMUNDO -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 pb-8">
      
      <!-- COLUNA 1: CATEGORIAS (PARTE 1) -->
      <div>
        <h3 class="font-extrabold text-white mb-3.5 uppercase text-xs tracking-wider opacity-90" style="font-family: var(--font-heading);">
          Categorias
        </h3>
        <ul class="list-unstyled space-y-2 m-0 p-0 text-xs sm:text-sm">
          <li>
            <a href={blogIndexUrl()} class="text-slate-300 hover:text-[#70EDED] transition-colors text-decoration-none d-block">
              Últimas Notícias
            </a>
          </li>
          {allCategories.slice(0, 4).map((cat) => (
            <li>
              <a
                href={`/categoria/${cat.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, '-')}`}
                class="text-slate-300 hover:text-[#70EDED] transition-colors text-decoration-none d-block"
              >
                {cat}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- COLUNA 2: EXPLORAR -->
      <div>
        <h3 class="font-extrabold text-white mb-3.5 uppercase text-xs tracking-wider opacity-90" style="font-family: var(--font-heading);">
          Explorar
        </h3>
        <ul class="list-unstyled space-y-2 m-0 p-0 text-xs sm:text-sm">
          {allCategories.slice(4, 9).map((cat) => (
            <li>
              <a
                href={`/categoria/${cat.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, '-')}`}
                class="text-slate-300 hover:text-[#70EDED] transition-colors text-decoration-none d-block"
              >
                {cat}
              </a>
            </li>
          ))}
          {allCategories.length <= 4 && (
            <>
              <li><a href="/blog" class="text-slate-300 hover:text-[#70EDED] transition-colors text-decoration-none d-block">Mais Lidas</a></li>
              <li><a href="/blog" class="text-slate-300 hover:text-[#70EDED] transition-colors text-decoration-none d-block">Guia de Compras</a></li>
            </>
          )}
        </ul>
      </div>

      <!-- COLUNA 3: INSTITUCIONAL -->
      <div>
        <h3 class="font-extrabold text-white mb-3.5 uppercase text-xs tracking-wider opacity-90" style="font-family: var(--font-heading);">
          Institucional
        </h3>
        <ul class="list-unstyled space-y-2 m-0 p-0 text-xs sm:text-sm">
          <li><a href="/sobre" class="text-slate-300 hover:text-[#70EDED] transition-colors text-decoration-none d-block">Sobre o TecExtreme</a></li>
          <li><a href="/contato" class="text-slate-300 hover:text-[#70EDED] transition-colors text-decoration-none d-block">Contato & Redação</a></li>
          <li><a href="/privacidade" class="text-slate-300 hover:text-[#70EDED] transition-colors text-decoration-none d-block">Política de Privacidade</a></li>
          <li><a href="/termos" class="text-slate-300 hover:text-[#70EDED] transition-colors text-decoration-none d-block">Termos de Uso</a></li>
        </ul>
      </div>

      <!-- COLUNA 4: SIGA O TECEXTREME -->
      <div>
        <h3 class="font-extrabold text-white mb-3.5 uppercase text-xs tracking-wider opacity-90" style="font-family: var(--font-heading);">
          Siga o {siteConfig.name}
        </h3>
        <ul class="list-unstyled space-y-2.5 m-0 p-0 text-xs sm:text-sm">
          {siteConfig.social?.instagram && (
            <li>
              <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer" class="text-slate-300 hover:text-[#70EDED] transition-colors text-decoration-none flex items-center gap-2.5">
                <i class="fab fa-instagram text-base w-4 text-center"></i>
                <span>Instagram</span>
              </a>
            </li>
          )}
          {siteConfig.social?.youtube && (
            <li>
              <a href={siteConfig.social.youtube} target="_blank" rel="noopener noreferrer" class="text-slate-300 hover:text-[#70EDED] transition-colors text-decoration-none flex items-center gap-2.5">
                <i class="fab fa-youtube text-base w-4 text-center"></i>
                <span>YouTube</span>
              </a>
            </li>
          )}
          {siteConfig.social?.whatsappChannel && (
            <li>
              <a href={siteConfig.social.whatsappChannel} target="_blank" rel="noopener noreferrer" class="text-slate-300 hover:text-[#25D366] transition-colors text-decoration-none flex items-center gap-2.5">
                <i class="fab fa-whatsapp text-base w-4 text-center text-[#25D366]"></i>
                <span>Canal no WhatsApp</span>
              </a>
            </li>
          )}
          {siteConfig.social?.facebook && (
            <li>
              <a href={siteConfig.social.facebook} target="_blank" rel="noopener noreferrer" class="text-slate-300 hover:text-[#70EDED] transition-colors text-decoration-none flex items-center gap-2.5">
                <i class="fab fa-facebook-f text-base w-4 text-center"></i>
                <span>Facebook</span>
              </a>
            </li>
          )}
          {siteConfig.social?.twitter && (
            <li>
              <a href={siteConfig.social.twitter} target="_blank" rel="noopener noreferrer" class="text-slate-300 hover:text-[#70EDED] transition-colors text-decoration-none flex items-center gap-2.5">
                <i class="fab fa-twitter text-base w-4 text-center"></i>
                <span>X / Twitter</span>
              </a>
            </li>
          )}
        </ul>
      </div>

    </div>

    <!-- SEÇÃO SITES PARCEIROS (PADRONIZADA SEM IMAGENS) -->
    {partnersData.length > 0 && (
      <div class="w-full border-t border-slate-800/80 pt-6 pb-2">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <span class="text-xs font-extrabold text-white uppercase tracking-wider flex items-center gap-2" style="font-family: var(--font-heading);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#70EDED]">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
            Sites Parceiros
          </span>

          <div class="flex flex-wrap items-center justify-center sm:justify-end gap-2">
            {partnersData.map((partner) => (
              <a
                href={partner.url}
                target="_blank"
                rel="noopener noreferrer"
                class="px-3 py-1.5 rounded-lg bg-slate-900/90 hover:bg-slate-800 border border-slate-800 text-slate-300 hover:text-white text-xs font-medium transition-all flex items-center gap-1.5 text-decoration-none group"
              >
                <span>{partner.name}</span>
                <i class="fas fa-external-link-alt text-[10px] text-slate-500 group-hover:text-[#70EDED] transition-colors"></i>
              </a>
            ))}
          </div>
        </div>
      </div>
    )}

    <!-- LINHA DIVISÓRIA E COPYRIGHT AUTOMÁTICO DINÂMICO -->
    <div class="w-full border-t border-slate-800/80 pt-6 mt-4 text-center">
      <p class="text-slate-400 text-xs font-normal m-0 tracking-wide">
        {siteConfig.name} - Copyright © {currentYear} - Todos os Direitos Reservados.
      </p>
    </div>

  </div>
</footer>
