---
/* 
  src/components/layout/ReadingProgressBar.astro
  BARRA DE PROGRESSO DE LEITURA (INDICADOR DE SCROLL):
  - Roda 100% na GPU usando CSS Scroll-Driven Animation (zero impacto no INP/Main Thread).
  - Inclui fallback via JS passivo (requestAnimationFrame) apenas para navegadores legados.
*/
---

<div class="reading-progress-bar" aria-hidden="true"></div>

<style>
  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    /*background: linear-gradient(90deg, var(--walker-primary, #70EDED), var(--walker-accent, #2222D3));*/
    background: var(--walker-primary, #70eded);
    transform-origin: left;
    transform: scaleX(0);
    z-index: 10000;
    pointer-events: none;
    will-change: transform;

    /* GPU-accelerated CSS Scroll-Driven Animation */
    animation: reading-progress-grow auto linear;
    animation-timeline: scroll();
  }

  @keyframes reading-progress-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>

<script>
  // Fallback para navegadores sem suporte nativo a CSS animation-timeline: scroll()
  if (
    typeof window !== "undefined" &&
    !CSS.supports("animation-timeline", "scroll()")
  ) {
    const progressBar = document.querySelector(
      ".reading-progress-bar",
    ) as HTMLElement | null;
    if (progressBar) {
      let ticking = false;

      const updateProgress = () => {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const scrollHeight =
          document.documentElement.scrollHeight -
          document.documentElement.clientHeight;
        const progress = scrollHeight > 0 ? scrollTop / scrollHeight : 0;
        progressBar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
        ticking = false;
      };

      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            window.requestAnimationFrame(updateProgress);
            ticking = true;
          }
        },
        { passive: true },
      );

      updateProgress();
    }
  }
</script>
