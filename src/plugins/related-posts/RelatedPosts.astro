---
/**
 * RelatedPosts.astro — Plugin Related Posts
 *
 * Exibe posts relacionados utilizando a mesma estilização de lista horizontal (Post Card List)
 * das páginas de categoria e arquivo.
 */
import { getCollection } from 'astro:content';
import { readData } from '../../lib/readData';
import { postUrl, getImageSrc } from '../../lib/blogRoutes';

interface Props {
  currentSlug: string;
  category: string;
  count?: number;
}

const { currentSlug, category, count } = Astro.props;

const pluginsConfig = readData('pluginsConfig.json', {}) as any;
const relatedConfig = pluginsConfig?.relatedPosts;
const enabled = relatedConfig?.enabled !== false;
const maxCount = count ?? relatedConfig?.count ?? 4;

let relatedPosts: any[] = [];

if (enabled) {
  const allPosts = await getCollection('blog');
  const filtered = allPosts.filter(p => p.slug !== currentSlug && !p.data.draft);

  const sameCategory = category ? filtered.filter(p => p.data.category === category) : [];

  // Shuffle posts da mesma categoria
  for (let i = sameCategory.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [sameCategory[i], sameCategory[j]] = [sameCategory[j], sameCategory[i]];
  }

  if (sameCategory.length < maxCount) {
    const otherPosts = filtered.filter(p => p.data.category !== category);
    for (let i = otherPosts.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [otherPosts[i], otherPosts[j]] = [otherPosts[j], otherPosts[i]];
    }
    relatedPosts = [...sameCategory, ...otherPosts].slice(0, maxCount);
  } else {
    relatedPosts = sameCategory.slice(0, maxCount);
  }
}
---

{enabled && relatedPosts.length > 0 && (
  <div class="mt-10 pt-8 border-t border-slate-200">
    <h3 class="text-xl sm:text-2xl font-black text-[#0B0F19] mb-6" style="font-family: var(--font-heading);">
      Artigos Relacionados
    </h3>

    <div class="flex flex-col border-t border-slate-100">
      {relatedPosts.map(post => {
        const postDate = post.data.pubDate instanceof Date
          ? post.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })
          : new Date(post.data.pubDate).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
        const postCategory = post.data.category || '';
        const catSlug = postCategory.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, '-');

        return (
          <article class="relative py-4 border-b border-slate-100 last:border-0 group">
            <div class="flex flex-row gap-4 sm:gap-5 items-center min-h-[110px] sm:min-h-[125px]">
              <!-- THUMBNAIL DO POST (ESQUERDA - 130x95px em telas pequenas, 172x125px em desktop) -->
              <a href={postUrl(post.slug)} class="block relative w-[130px] sm:w-[172px] h-[95px] sm:h-[125px] flex-shrink-0 overflow-hidden rounded-2xl bg-slate-100">
                {post.data.heroImage ? (
                  <img
                    src={getImageSrc(post.data.heroImage)}
                    alt={post.data.title}
                    loading="lazy"
                    width="400"
                    height="225"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                ) : (
                  <div class="w-full h-full bg-slate-200 flex items-center justify-center text-slate-400 font-bold text-xs">
                    TecExtreme
                  </div>
                )}
              </a>

              <!-- DETALHES DO POST (DIREITA) -->
              <div class="flex-1 min-w-0 flex flex-col justify-center">
                {postCategory && (
                  <div class="flex items-center gap-1.5 mb-1.5">
                    <a
                      href={`/categoria/${catSlug}`}
                      class="text-[11px] font-extrabold uppercase tracking-wider text-[#2222D3] hover:underline text-decoration-none"
                    >
                      {postCategory}
                    </a>
                    <span class="w-1.5 h-1.5 rounded-xs bg-[#2222D3] inline-block"></span>
                  </div>
                )}

                <h4 class="m-0 leading-snug" style="font-family: var(--font-heading);">
                  <a
                    href={postUrl(post.slug)}
                    class="post-title-link font-extrabold text-decoration-none block line-clamp-2 hover:text-[#2222D3]"
                    style="font-size: 1.05rem; color: #0B0F19; line-height: 1.35; transition: color 0.2s ease;"
                  >
                    {post.data.title}
                  </a>
                </h4>

                <span class="text-xs text-slate-400 mt-2 block">
                  {postDate}
                </span>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
)}
